# Copy to .env.local and fill in (ask Danish for the values). Never commit real keys.

# Supabase (Project Settings -> API). Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/scripts only. NEVER prefix with NEXT_PUBLIC_. Required.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for /console and /status (checked on the server; never NEXT_PUBLIC_). Required.
CONSOLE_PASSWORD=

# AI provider (server only): pregenerated | gemini | anthropic. A setting, not a secret:
# keep pregenerated (no API calls) unless Danish gives you a Gemini or Claude key.
#   pregenerated  all text from data/messages.json (free)
#   gemini        same text + Gemini free tier for the photo check only
#   anthropic     live Claude for wording, SMS, agent decisions and photo check
LLM_PROVIDER=pregenerated

# Gemini (free tier, photo check only). Optional. Server only; never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model override; empty tries gemini-3.8-flash then gemini-3.5-flash-lite.
GEMINI_MODEL=

# Claude API (only used when LLM_PROVIDER=anthropic). Optional. Server only; never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# OpenStreetMap address lookup for sign-ups (Nominatim). Optional: an identifying User-Agent,
# e.g. "FreezeLine/0.1 (contact: team email)". No key needed. Server only.
NOMINATIM_USER_AGENT=

# How texts are sent: twilio (default) or textbee (an Android phone with a SIM, no A2P 10DLC).
SMS_PROVIDER=twilio
# TextBee, when SMS_PROVIDER=textbee. Dashboard -> API Keys. Server only.
TEXTBEE_API_KEY=
# Optional: pin the sending phone, and point at a self-hosted instance.
TEXTBEE_DEVICE_ID=
TEXTBEE_BASE_URL=https://api.textbee.dev/api/v1

# Voice agent (voice/, Python, self-hosted). Server only; never NEXT_PUBLIC_.
# Twilio Console -> Account Info. A trial number can only call verified caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The number calls come FROM (never your own phone; that's DEMO_CALL_TO). Older trials: leave empty.
# Newer trials pair your phone with one trial number (Console -> Voice -> Try it out): put it here,
# or Twilio refuses with 573003 "from number isn't assigned to this verified voice recipient".
TWILIO_PHONE_NUMBER=
# The number the emergency-contact call comes FROM. On a trial, the contact's phone must be verified
# too, and Twilio pairs it with its own trial number (Console -> Voice -> Try it out): put that here.
# Empty: TWILIO_PHONE_NUMBER is used (fine on an upgraded account).
EMERGENCY_CALL_FROM=

# Public hostname the agent serves on (ngrok host during development, e.g. abc123.ngrok-free.app).
PUBLIC_HOSTNAME=

# ElevenLabs agent (alternative to the self-hosted Python agent: no tunnel, no local process).
# Dashboard -> Agents for the agent id; Dashboard -> Phone Numbers for the id of the imported
# Twilio number. /api/voice/call uses these three; leave them empty to keep using voice/agent.py.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=

# Where the agent posts each call's answers (saved in Supabase voice_calls):
VOICE_RESULT_URL=http://localhost:3000/api/voice/result
# Shared secret for /make-call and the result route. Any long random string.
VOICE_SHARED_SECRET=

# Demo call when Run agent runs (optional; off when empty). Your own phone, +1XXXXXXXXXX: on a Twilio
# trial it must be the phone you signed up with. See TWILIO_PHONE_NUMBER above for trials.
DEMO_CALL_TO=
# Optional: the first name the demo call greets.
DEMO_CALL_NAME=
# Seconds of silence before the agent ends the call and the retry ladder takes over.
VOICE_IDLE_SECONDS=12
# Answering-machine detection: leave off for testing, set to 1 when calling homes at scale.
VOICE_AMD=0

# Whisper (local speech-to-text). 'base' for a quick first test, 'large-v3-turbo' for real calls.
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Kokoro model files. Default: voice/models/. Download from
# github.com/thewh1teagle/kokoro-onnx/releases/tag/model-files-v1.1
KOKORO_MODEL=
KOKORO_VOICES=
