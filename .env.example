# Copy to .env.local and fill in. Never commit real keys.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server/scripts only. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider (server only): pregenerated | gemini | anthropic. Default pregenerated = no API calls.
#   pregenerated  all text from data/messages.json (free)
#   gemini        same text + Gemini free tier for the photo check only
#   anthropic     live Claude for wording, SMS, agent decisions and photo check
LLM_PROVIDER=pregenerated

# Gemini (free tier, photo check only). Server only; never NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-2.5-flash

# Claude API (only used when LLM_PROVIDER=anthropic). Server only; never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=your-anthropic-api-key
