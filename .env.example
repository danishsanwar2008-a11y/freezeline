# Copy to .env.local and fill in (ask Danish for the values). Never commit real keys.

# Supabase (Project Settings -> API). Required.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/scripts only. NEVER prefix with NEXT_PUBLIC_. Required.
SUPABASE_SERVICE_ROLE_KEY=

# Shared password for /console and /status (checked on the server; never NEXT_PUBLIC_). Required.
CONSOLE_PASSWORD=

# AI provider (server only): pregenerated | gemini | anthropic. A setting, not a secret:
# keep pregenerated (no API calls) unless Danish gives you a Gemini or Claude key.
#   pregenerated  all text from data/messages.json (free)
#   gemini        same text + Gemini free tier for the photo check only
#   anthropic     live Claude for wording, SMS, agent decisions and photo check
LLM_PROVIDER=pregenerated

# Gemini (free tier, photo check only). Optional. Server only; never NEXT_PUBLIC_.
GEMINI_API_KEY=
# Optional model override; empty tries gemini-3.8-flash then gemini-3.5-flash-lite.
GEMINI_MODEL=

# Claude API (only used when LLM_PROVIDER=anthropic). Optional. Server only; never NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# OpenStreetMap address lookup for sign-ups (Nominatim). Optional: an identifying User-Agent,
# e.g. "FreezeLine/0.1 (contact: team email)". No key needed. Server only.
NOMINATIM_USER_AGENT=

# Voice agent (voice/, Python, self-hosted). Server only; never NEXT_PUBLIC_.
# Twilio Console -> Account Info. A trial number can only call verified caller IDs.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Public hostname the agent serves on (ngrok host during development, e.g. abc123.ngrok-free.app).
PUBLIC_HOSTNAME=
# Where finished calls post their answers: http://localhost:3000/api/voice/result
VOICE_RESULT_URL=
# Shared secret for /make-call and the result route. Any long random string.
VOICE_SHARED_SECRET=
# Seconds of silence before the agent ends the call and the retry ladder takes over.
VOICE_IDLE_SECONDS=12
# Answering-machine detection: leave off for testing, set to 1 when calling homes at scale.
VOICE_AMD=0

# Whisper (local speech-to-text). 'base' for a quick first test, 'large-v3-turbo' for real calls.
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8

# Kokoro model files. Default: voice/models/. Download from
# github.com/thewh1teagle/kokoro-onnx/releases/tag/model-files-v1.1
KOKORO_MODEL=
KOKORO_VOICES=
